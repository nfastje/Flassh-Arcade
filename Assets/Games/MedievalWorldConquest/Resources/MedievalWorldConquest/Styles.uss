/* Medieval World Conquest: dark wood bars, parchment panels, brass accents. */

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.centered {
    align-items: center;
    justify-content: center;
}

.dim {
    background-color: rgba(10, 6, 2, 0.55);
}

/* ---------------------------------------------------------------- parchment panels */

.panel {
    background-color: rgb(241, 227, 195);
    border-width: 3px;
    border-color: rgb(122, 90, 51);
    border-radius: 8px;
    padding: 18px 24px;
    color: rgb(58, 42, 24);
    align-items: center;
}

.title {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(92, 52, 20);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.subtitle {
    font-size: 17px;
    color: rgb(110, 84, 54);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
    white-space: normal;
}

.heading {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(92, 52, 20);
    margin-top: 12px;
    margin-bottom: 6px;
}

.body-text {
    font-size: 15px;
    color: rgb(58, 42, 24);
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 520px;
}

.error-text {
    font-size: 15px;
    color: rgb(150, 40, 25);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

/* ---------------------------------------------------------------- buttons */

.btn {
    background-color: rgb(139, 90, 43);
    border-width: 2px;
    border-color: rgb(84, 52, 22);
    border-radius: 6px;
    color: rgb(250, 238, 212);
    font-size: 18px;
    -unity-font-style: bold;
    min-width: 220px;
    height: 44px;
    margin: 5px;
    transition-duration: 0.1s;
}

.btn:hover {
    background-color: rgb(163, 110, 58);
}

.btn:active {
    background-color: rgb(110, 70, 32);
}

.btn--small {
    min-width: 0;
    height: 34px;
    font-size: 15px;
    padding: 0 12px;
}

.option-row {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.option {
    background-color: rgb(226, 206, 166);
    border-width: 2px;
    border-color: rgb(160, 126, 82);
    border-radius: 6px;
    color: rgb(58, 42, 24);
    font-size: 16px;
    margin: 4px;
    padding: 6px 12px;
    min-width: 70px;
    white-space: normal;
}

.option:hover {
    background-color: rgb(236, 219, 184);
}

.option--selected {
    background-color: rgb(139, 90, 43);
    border-color: rgb(84, 52, 22);
    color: rgb(250, 238, 212);
}

.option--selected:hover {
    background-color: rgb(163, 110, 58);
}

.option:disabled {
    opacity: 0.4;
}

.option-wide {
    width: 250px;
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------- in-game HUD */

/* The top bar: two rows, as in Tribal Wars. 84px in all (the pages below start there). */
.top-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 84px;
    flex-direction: column;
    background-color: rgb(59, 42, 26);
    border-bottom-width: 3px;
    border-color: rgb(140, 105, 50);
}

.top-row {
    flex-direction: row;
    align-items: center;
    padding: 0 12px;
    flex-shrink: 0;
}

/* Above: the tabs, the player's name, the clock and the menu. */
.top-row--nav {
    height: 41px;
    background-color: rgb(44, 31, 18);
    border-bottom-width: 1px;
    border-color: rgba(140, 105, 50, 0.6);
}

/* Below: the village and its resources. */
.top-row--village {
    height: 40px;
}

.top-row > .btn,
.top-row > .spacer {
    flex-shrink: 0;
}

.top-row--nav > .icon-button {
    height: 32px;
    padding: 2px 8px 2px 5px;
}

.top-row--nav .icon-button-label {
    font-size: 14px;
}

.village-arrow {
    min-width: 0;
    width: 26px;
    height: 30px;
    padding: 0;
    margin: 0 4px;
    font-size: 16px;
}

.end-panel {
    max-width: 620px;
}

/* Catching up on time spent away: what happened, and a bar of the days simulated. */
.catch-up-panel {
    width: 560px;
}

.catch-up-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(92, 52, 20);
    -unity-text-align: middle-center;
    white-space: normal;
}

.catch-up-progress {
    width: 100%;
    height: 16px;
    border-radius: 8px;
    margin-top: 14px;
    margin-bottom: 8px;
}

/* The winning tribes and top ten lords when a world ends. */
.end-standings {
    max-height: 360px;
    margin-top: 8px;
}

/* Top-bar names are plain text that underlines, a little darker, under the pointer. */
.top-link {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    height: auto;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    flex-shrink: 1;
}

.top-player {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(200, 180, 140);
    margin-right: 10px;
    flex-shrink: 1;
}

.village-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(232, 200, 114);
    margin: 0 4px;
}

.top-info {
    font-size: 14px;
    color: rgb(200, 180, 140);
    margin-left: 6px;
    flex-shrink: 0;
    white-space: nowrap;
}

.resource {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 5px;
    padding: 3px 6px;
    margin-right: 4px;
}

/* Each value keeps a fixed width (room for "400,000"; the population for "24,000/24,000"), right-aligned, so the
   bar doesn't shift as the numbers grow; and each character has a cell of its own (see SteadyNumber), so the
   digits don't shift either. */
.resource-value {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(245, 235, 210);
    white-space: nowrap;
    margin: 0 0 0 4px;
    padding: 0;
    min-width: 66px;
    flex-direction: row;
    justify-content: flex-end;
}

.resource-value--wide {
    min-width: 118px;
}

/* One character of a steady number: every digit the same width, commas and slashes narrower. */
.steady-cell {
    width: 10px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.steady-cell--narrow {
    width: 4px;
}

.resource-value--full {
    color: rgb(255, 120, 95);
}

.spacer {
    flex-grow: 1;
}

.clock {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(245, 235, 210);
    margin: 0 6px 0 6px;
    flex-shrink: 0;
    white-space: nowrap;
}

/* Top-bar buttons with an icon: the map, reports and ranking. */
.icon-button {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.2);
    border-width: 2px;
    border-color: rgb(110, 80, 40);
    border-radius: 6px;
    padding: 2px 6px;
    margin: 0 3px;
    height: 36px;
    min-width: 38px;
    flex-shrink: 0;
    justify-content: center;
    overflow: visible;
}

.icon-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.icon-button--selected {
    background-color: rgb(139, 90, 43);
    border-color: rgb(232, 200, 114);
}

.icon-button-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 225, 190);
    margin-left: 5px;
}

/* The small red count of unread reports on the scroll. */
.unread-badge {
    position: absolute;
    right: -6px;
    top: -6px;
    min-width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: rgb(200, 30, 25);
    border-width: 1px;
    border-color: rgb(255, 220, 200);
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0 3px;
}

.resource-icon {
    margin-right: 5px;
}
/* ---------------------------------------------------------------- village tab */

.detail-effect {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(60, 95, 35);
    white-space: normal;
    margin-top: 4px;
}

.build-row {
    background-color: rgba(255, 255, 255, 0.35);
    border-width: 2px;
    border-color: rgba(122, 90, 51, 0.45);
    border-radius: 6px;
    padding: 6px 8px;
    margin-bottom: 6px;
}

.build-row:hover {
    background-color: rgba(255, 255, 255, 0.55);
}

.row-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.row-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(72, 44, 18);
}

.row-level {
    font-size: 13px;
    color: rgb(110, 84, 54);
}

.row-info {
    font-size: 12px;
    color: rgb(58, 42, 24);
    white-space: normal;
    margin-top: 2px;
}

.row-reason {
    font-size: 12px;
    color: rgb(150, 40, 25);
    white-space: normal;
}

.build-btn {
    margin: 4px 0 2px 0;
    height: 28px;
    font-size: 13px;
}

.build-btn:disabled {
    opacity: 0.45;
}

.queue-item {
    margin-bottom: 6px;
}

/* A slot in the headquarters' construction queue: always the same height, used or not. */
.queue-slot {
    flex-direction: row;
    align-items: center;
    height: 46px;
    margin-bottom: 4px;
    padding: 4px 8px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.35);
    flex-shrink: 0;
}

/* Slimmer slots where a screen has several queues (the Recruit screen). */
.queue-slot--compact {
    height: 36px;
    margin-bottom: 3px;
    padding: 2px 8px;
}

.queue-slot--compact .progress {
    height: 6px;
}

.queue-slot--compact .queue-cancel {
    height: 22px;
}

/* A unit's research progress on its own row in the smithy. */
.research-progress {
    width: 180px;
    margin-top: 3px;
}

.queue-slot--empty {
    background-color: rgba(255, 255, 255, 0.12);
}

.queue-slot--empty .row-title {
    color: rgb(130, 108, 80);
    -unity-font-style: italic;
}

.queue-slot-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.queue-cancel {
    margin: 0 0 0 10px;
}

.progress {
    height: 8px;
    background-color: rgba(0, 0, 0, 0.18);
    border-radius: 4px;
    margin-top: 3px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    width: 0;
    background-color: rgb(110, 150, 60);
    border-radius: 4px;
}

.cancel-btn {
    margin: 4px 0 0 0;
    height: 24px;
    font-size: 12px;
    background-color: rgb(140, 60, 40);
}

/* Tribal Wars' green level squares on the buildings. */
.level-badge {
    position: absolute;
    translate: -50% 0;
    min-width: 22px;
    height: 20px;
    padding: 0 4px;
    margin: 0;
    background-color: rgb(78, 128, 52);
    border-width: 1px;
    border-color: rgb(210, 240, 180);
    border-radius: 2px;
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-badge:hover {
    background-color: rgb(100, 160, 66);
}

.level-timer {
    position: absolute;
    translate: -50% 0;
    background-color: rgba(30, 50, 20, 0.85);
    border-radius: 2px;
    color: rgb(230, 250, 210);
    font-size: 11px;
    padding: 0 4px;
}
/* ---------------------------------------------------------------- full-screen panels (reports, ranking) */

.army {
    position: absolute;
    left: 0;
    right: 0;
    top: 84px;
    bottom: 0;
    flex-direction: row;
    background-color: rgb(241, 227, 195);
    padding: 10px 14px;
}
.garrison-count {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(58, 42, 24);
}

.garrison-count--none {
    color: rgba(58, 42, 24, 0.35);
}

.unit-row--locked {
    opacity: 0.55;
}

.unit-stats {
    color: rgb(92, 70, 40);
}

.unit-controls {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 4px;
}

.count-btn {
    min-width: 40px;
    height: 26px;
    margin: 0 3px 0 0;
    padding: 0 6px;
    font-size: 13px;
}

.recruit-btn {
    height: 26px;
    margin: 0 0 0 8px;
    font-size: 13px;
    min-width: 150px;
}

.recruit-btn:disabled {
    opacity: 0.45;
}

.recruit-item {
    background-color: rgba(255, 255, 255, 0.35);
    border-radius: 5px;
    padding: 4px 8px;
}

/* ---------------------------------------------------------------- map tab */

/* Bottom left: "go to my village" above the minimap. */
.map-corner {
    position: absolute;
    left: 12px;
    bottom: 12px;
    align-items: flex-start;
}

.map-home-btn {
    margin: 0 0 6px 0;
}

.map-tooltip {
    position: absolute;
    background-color: rgba(59, 42, 26, 0.94);
    border-width: 2px;
    border-color: rgb(140, 105, 50);
    border-radius: 5px;
    padding: 4px 9px;
}

.tooltip-owner {
    font-size: 12px;
    -unity-font-style: bold;
}

.tooltip-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(232, 200, 114);
}

.tooltip-text {
    font-size: 13px;
    color: rgb(245, 235, 210);
}

.minimap {
    border-width: 3px;
    border-color: rgb(122, 90, 51);
    border-radius: 4px;
    background-color: rgb(20, 16, 10);
    overflow: hidden;
}
.minimap-frame {
    position: absolute;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.9);
}

.name-row {
    align-items: center;
    margin-bottom: 4px;
}

.name-field {
    width: 240px;
    margin: 4px;
}

/* Text boxes (the player's name, the village's): parchment-colored, dark text, tall enough to read. */
.name-field,
.rename-field {
    height: 34px;
    flex-shrink: 0;
}

/* Number boxes (coordinates, amounts): the same readable style, a little shorter. */
.coord-field,
.amount-field {
    height: 30px;
    flex-shrink: 0;
}

.name-field > .unity-base-text-field__input,
.rename-field > .unity-base-text-field__input,
.coord-field > .unity-base-text-field__input,
.amount-field > .unity-base-text-field__input {
    background-color: rgb(252, 245, 228);
    border-width: 2px;
    border-color: rgb(160, 126, 82);
    border-radius: 4px;
    padding: 2px 8px;
    -unity-text-align: middle-left;
}

.name-field .unity-text-element,
.rename-field .unity-text-element,
.coord-field .unity-text-element,
.amount-field .unity-text-element {
    color: rgb(58, 42, 24);
    font-size: 16px;
}

/* The start screen's save slots: cards side by side, all as tall as the tallest (the row stretches them), each
   with its text above and its buttons along the bottom, level across the cards. */
.slot-row {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    flex-shrink: 0;
}

.slot-card {
    width: 290px;
    min-height: 200px;
    margin: 6px;
    padding: 10px 12px;
    background-color: rgba(255, 255, 255, 0.35);
    border-width: 2px;
    border-color: rgb(160, 126, 82);
    border-radius: 6px;
    flex-shrink: 0;
}

.slot-title {
    font-size: 18px;
    margin-bottom: 4px;
}

.slot-body {
    flex-grow: 1;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.slot-body > * {
    flex-shrink: 0;
}

.slot-line {
    font-size: 14px;
    color: rgb(58, 42, 24);
    white-space: normal;
    margin-bottom: 2px;
}

.slot-line--strong {
    -unity-font-style: bold;
}

.slot-line--faint {
    color: rgb(130, 108, 80);
    -unity-font-style: italic;
}

.slot-actions {
    flex-direction: row;
    justify-content: flex-start;
    flex-shrink: 0;
}

.slot-delete {
    background-color: rgb(140, 60, 40);
}

/* The quest box at the top of the village pane. */
/* The quest: a bar (the quest and its progress, Claim when done) that unfolds to the goal, why, and reward. */
.quest-header {
    flex-direction: row;
    align-items: center;
}

.quest-header:hover {
    background-color: rgb(208, 177, 124);
}

.quest-caret {
    width: 14px;
    font-size: 13px;
    color: rgb(60, 36, 14);
    margin: 0;
    padding: 0;
}

.quest-heading {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.quest-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(60, 36, 14);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.quest-progress {
    font-size: 12px;
    color: rgb(72, 44, 18);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.quest-progress--done {
    color: rgb(40, 95, 25);
    -unity-font-style: bold;
}

.quest-claim {
    flex-shrink: 0;
    margin: 0 0 0 4px;
}

.quest-body {
    padding: 4px 8px 6px 8px;
}

.quest-body > * {
    flex-shrink: 0;
}

.quest-goal {
    white-space: normal;
}

.quest-why {
    white-space: normal;
    font-size: 11px;
    margin-top: 3px;
}

/* The reward wraps rather than overflowing when the amounts are big; nothing in it stretches or squeezes. */
.quest-reward {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 4px;
}

.quest-reward > * {
    flex-shrink: 0;
}

.quest-reward-label {
    font-size: 13px;
    color: rgb(58, 42, 24);
    margin-right: 6px;
}

.quest-amount {
    font-size: 12px;
    margin-right: 6px;
}
/* The new-world screen's warning about fast real-time worlds. */
.speed-warning {
    white-space: normal;
    margin: 2px 0 4px 140px;
    -unity-text-align: middle-left;
}

/* Pausing (worlds that stand still while closed): the button beside the clock, and the clock while paused. */
.pause-btn {
    margin: 0 8px 0 0;
    min-width: 70px;
}

.clock--paused {
    color: rgb(255, 200, 90);
}

/* A tip: a banner just under the top bar. */
.tip-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 92px;
    align-items: center;
}

.tip-banner {
    width: 560px;
    max-width: 70%;
    background-color: rgb(252, 245, 228);
    border-width: 2px;
    border-left-width: 6px;
    border-color: rgb(160, 126, 82);
    border-left-color: rgb(70, 120, 170);
    border-radius: 6px;
    padding: 8px 12px;
}

.tip-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(70, 120, 170);
}

.tip-text {
    font-size: 14px;
    white-space: normal;
    color: rgb(58, 42, 24);
    margin: 2px 0 6px 0;
}

.tip-actions {
    justify-content: flex-start;
    align-items: center;
}

.tip-off {
    margin-left: 12px;
}

/* The player's lifetime record (from the start screen). */
.record-panel {
    width: 460px;
}

.record-body {
    align-self: stretch;
}

.record-value {
    width: 140px;
}

/* The new-world screen: one row per setting, all on one page. */
.new-world-panel {
    align-items: stretch;
    width: 720px;
}

.new-world-panel > .title {
    font-size: 32px;
    margin-bottom: 10px;
}

.new-world-panel > .option-row {
    justify-content: center;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin: 3px 0;
    flex-shrink: 0;
}

.setting-label {
    width: 130px;
    flex-shrink: 0;
    margin-right: 10px;
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

.setting-options {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
}

.setting-options > .option-wide {
    width: 220px;
    font-size: 14px;
}

.legend-swatch {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(58, 42, 24);
    margin-right: 8px;
}

/* ---------------------------------------------------------------- troop movements (army tab) */

.movements {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 60px;
}

.incoming-warning {
    background-color: rgb(150, 35, 22);
    border-width: 2px;
    border-color: rgb(255, 150, 110);
    border-radius: 5px;
    color: rgb(255, 235, 215);
    font-size: 14px;
    -unity-font-style: bold;
    padding: 3px 10px;
    margin-right: 6px;
    flex-shrink: 0;
    white-space: nowrap;
}

.incoming-panel {
    position: absolute;
    left: 12px;
    bottom: 12px;
    max-height: 170px;
    background-color: rgba(241, 227, 195, 0.95);
    border-width: 2px;
    border-left-width: 5px;
    border-color: rgb(170, 45, 30);
    border-radius: 6px;
    padding: 4px 10px 6px 10px;
}

.incoming-heading {
    color: rgb(150, 30, 20);
    margin-bottom: 2px;
}

.incoming-list {
    flex-shrink: 1;
}

/* ---------------------------------------------------------------- ranking tab */

.ranking {
    justify-content: center;
}

.ranking-column {
    width: 620px;
}

/* Only the list gives way when space is short: the heading, summary, switches and pager keep their size. */
.ranking-column > * {
    flex-shrink: 0;
}

.ranking-column > .ranking-list,
.ranking-column > .stats {
    flex-shrink: 1;
    min-height: 0;
}

.ranking-list {
    flex-grow: 1;
}

/* Three lines, always: the rows below never move with its length. */
.ranking-summary {
    height: 66px;
    margin-top: 6px;
    overflow: hidden;
    white-space: normal;
    -unity-text-align: upper-left;
}

.ranking-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 8px;
    border-bottom-width: 1px;
    border-color: rgba(122, 90, 51, 0.25);
}

.ranking-header {
    margin-top: 10px;
    border-bottom-width: 2px;
    border-color: rgba(122, 90, 51, 0.5);
}

.ranking-header > Label {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(92, 52, 20);
}

.ranking-row--you {
    background-color: rgba(255, 225, 140, 0.6);
    border-radius: 4px;
}

.ranking-rank {
    width: 40px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(92, 52, 20);
}

/* Takes the room left over; a name too long for it is cut off rather than pushing into the numbers. */
.ranking-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.ranking-name > * {
    flex-shrink: 0;
}

/* The tribes' table has two more columns (members, and the share with allies), so it's wider. */
.ranking-column--tribes {
    width: 820px;
    max-width: 100%;
}

.ranking-narrow {
    width: 80px;
}

.ranking-name .row-reason {
    margin-left: 8px;
}

/* Numbers and their headings alike: centered in a fixed width, with no stray margins, so each lines up. */
.ranking-number {
    width: 100px;
    flex-shrink: 0;
    font-size: 15px;
    color: rgb(58, 42, 24);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0 4px;
}

.ranking-rank {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
}

/* Statistics (in the Ranking tab). */
.stats {
    flex-grow: 1;
}

.stats > * {
    flex-shrink: 0;
}

.stats > .ranking-list {
    flex-shrink: 1;
    min-height: 0;
}

/* The statistics take the screen's width: resources, troops and villages in three columns side by side. */
.ranking-column--wide {
    width: 1180px;
    max-width: 100%;
}

.stats-columns {
    flex-direction: row;
    align-items: flex-start;
}

.stats-column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 8px;
}

.stats-column .ranking-rank {
    width: 34px;
}

.stats-column .ranking-number {
    width: 80px;
}

.stats-column .ranking-name {
    min-width: 0;
    overflow: hidden;
}

.stats-heading {
    margin-top: 12px;
    margin-bottom: 2px;
}

.stats-wide {
    width: 150px;
}

.stats-day {
    width: 110px;
}

/* ---------------------------------------------------------------- send troops dialog */

.btn:disabled {
    opacity: 0.45;
}

.send-panel {
    width: 860px;
    max-height: 90%;
    align-items: stretch;
}

.send-panel > .heading {
    -unity-text-align: middle-center;
    margin-top: 0;
}

.send-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 0;
    border-bottom-width: 1px;
    border-color: rgba(122, 90, 51, 0.25);
}

.send-name {
    width: 140px;
}

/* How many of a unit to send: a box to type in, then "(how many are home)" to send them all, and "none". */
.send-amount {
    width: 100px;
    margin: 0 8px 0 0;
}

.send-all {
    min-width: 70px;
    margin-right: 10px;
}

.send-none {
    margin-right: 10px;
}

.send-plus {
    margin-right: 4px;
}

.catapult-target {
    flex-grow: 1;
    margin: 0;
}

.send-summary {
    font-size: 14px;
    margin: 10px 0 4px 0;
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------- reports tab */

.reports-list-column {
    width: 380px;
    padding-right: 14px;
    margin-right: 14px;
    border-right-width: 2px;
    border-color: rgba(122, 90, 51, 0.4);
}

.reports-actions {
    justify-content: flex-start;
    margin-bottom: 6px;
}

.reports-list {
    flex-grow: 1;
}

.reports-detail {
    flex-grow: 1;
}

.report-item {
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 2px;
    border-left-width: 5px;
    border-color: rgba(122, 90, 51, 0.45);
    border-left-color: rgb(110, 150, 60);
    border-radius: 5px;
    color: rgb(58, 42, 24);
    font-size: 13px;
    -unity-text-align: middle-left;
    white-space: normal;
    padding: 5px 8px;
    margin: 0 0 5px 0;
}

.report-item:hover {
    background-color: rgba(255, 255, 255, 0.55);
}

.report-item--lost {
    border-left-color: rgb(170, 45, 30);
}

.report-item--unread {
    -unity-font-style: bold;
    background-color: rgba(255, 236, 170, 0.55);
}

.report-item--selected {
    border-color: rgb(192, 140, 40);
    background-color: rgba(255, 225, 140, 0.75);
}

.report-side {
    margin-top: 12px;
    margin-bottom: 4px;
}

.troop-table {
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 1px;
    border-color: rgba(122, 90, 51, 0.45);
    border-radius: 5px;
    padding: 4px 6px;
    align-self: flex-start;
}

.troop-row {
    flex-direction: row;
}

/* Every cell exactly the same width with no margins (labels get theme margins otherwise), so the numbers sit
   right under their unit's icon. */
.troop-cell {
    width: 62px;
    min-width: 62px;
    flex-shrink: 0;
    margin: 0;
    font-size: 13px;
    color: rgb(58, 42, 24);
    -unity-text-align: middle-center;
    padding: 2px 0;
}

.troop-cell--zero {
    color: rgba(58, 42, 24, 0.3);
}

.troop-head {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(92, 52, 20);
    align-items: center;
    justify-content: center;
}

.troop-label {
    width: 60px;
    min-width: 60px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

/* Loot: each resource's icon and amount, then carried / could carry. */
.loot-line {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 8px;
}

.loot-label {
    margin-right: 6px;
}

.loot-icon {
    margin: 0 3px 0 8px;
}

.loot-value {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(60, 95, 35);
    margin: 0;
}

.loot-line--lost .loot-value {
    color: rgb(150, 40, 25);
}

.loot-total {
    font-size: 13px;
    color: rgb(110, 84, 54);
    margin-left: 16px;
}

.toast {
    position: absolute;
    top: 96px;
    left: 0;
    right: 0;
    align-items: center;
}

.toast-label {
    background-color: rgba(241, 227, 195, 0.95);
    border-width: 2px;
    border-color: rgb(122, 90, 51);
    border-radius: 6px;
    padding: 8px 16px;
    color: rgb(58, 42, 24);
    font-size: 16px;
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------- the village view's pane (Tribal Wars style) */

.icon {
    -unity-background-scale-mode: scale-to-fit;
}

.village-pane {
    position: absolute;
    right: 0;
    top: 84px;
    bottom: 0;
    padding: 10px 10px;
    background-color: rgba(241, 227, 195, 0.97);
    border-left-width: 3px;
    border-color: rgb(122, 90, 51);
}

/* Boxes and their lines keep their natural height: a long quest never squeezes the boxes below it. */
.pane-box {
    background-color: rgb(250, 240, 214);
    border-width: 1px;
    border-color: rgb(160, 126, 82);
    margin-bottom: 10px;
    flex-shrink: 0;
}

.pane-box > * {
    flex-shrink: 0;
}

/* The village pane's boxes scroll when they don't all fit. */
.village-pane-scroll {
    flex-grow: 1;
}

.pane-title {
    background-color: rgb(196, 163, 108);
    color: rgb(60, 36, 14);
    font-size: 14px;
    -unity-font-style: bold;
    padding: 3px 8px;
}

.pane-line {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 3px 8px;
    border-bottom-width: 1px;
    border-color: rgba(160, 126, 82, 0.3);
}

.pane-icon {
    margin-right: 6px;
}

.pane-name {
    font-size: 13px;
    color: rgb(58, 42, 24);
    flex-grow: 1;
}

.pane-value {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(58, 42, 24);
}

.pane-count {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(58, 42, 24);
    margin-right: 5px;
}

.pane-links {
    flex-direction: row;
    padding: 2px 4px;
}

.pane-link {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(125, 60, 20);
    font-size: 13px;
    -unity-font-style: bold;
    padding: 2px 4px;
    margin: 0;
}

.pane-link {
    border-bottom-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}



/* ---------------------------------------------------------------- building screens */

.window {
    width: 860px;
    height: 88%;
    align-items: stretch;
    padding: 12px 16px;
}

.window-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.window-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(92, 52, 20);
}

.window-description {
    font-size: 13px;
    margin-bottom: 6px;
}

.window-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.window-section {
    padding-right: 6px;
}

.cost-line {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.cost-icon {
    margin: 0 3px 0 8px;
}

.cost-value {
    font-size: 12px;
    color: rgb(58, 42, 24);
}

.cost-time {
    font-size: 12px;
    color: rgb(110, 84, 54);
    margin-left: 10px;
}

.upgrade-box {
    align-items: flex-end;
    min-width: 330px;
}

.hq-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.hq-row-name {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 10px;
}

.rename-row {
    flex-direction: row;
    justify-content: flex-start;
    margin: 4px 0 8px 0;
}

.rename-field {
    width: 280px;
    margin: 0 8px;
}

.queue-list {
    margin-bottom: 6px;
}

.link-btn {
    align-self: flex-start;
    margin-top: 10px;
}

.unit-header {
    flex-direction: row;
    align-items: center;
}

.unit-icon {
    margin-right: 8px;
}

.unit-names {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    justify-content: space-between;
}

.troop-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.troop-grid-cell {
    flex-direction: row;
    align-items: center;
    width: 90px;
    padding: 3px 4px;
}

.troop-grid-cell .garrison-count {
    margin-left: 6px;
}

.send-to-row {
    flex-direction: row;
    align-items: center;
}

.coord-field {
    width: 70px;
    margin: 0 4px;
}

.send-to-row > .row-title {
    margin-right: 6px;
}

/* The market: amounts to send, and the offer form. */
.amount-field {
    width: 80px;
    margin: 0 8px 0 2px;
}

/* The offer form's rows: a fixed-width label, the amount, then the resource buttons. */
.offer-row {
    margin-top: 4px;
}

.offer-label {
    width: 52px;
}

.offer-row > .coord-field {
    width: 80px;
    margin: 0 8px 0 0;
}

/* A resource to choose: its icon and name. */
.resource-pick {
    flex-direction: row;
    align-items: center;
    background-color: rgb(226, 206, 166);
    border-width: 2px;
    border-color: rgb(160, 126, 82);
    border-radius: 5px;
    padding: 2px 8px 2px 4px;
    margin: 0 4px 0 0;
    height: 30px;
    flex-shrink: 0;
}

.resource-pick:hover {
    background-color: rgb(236, 219, 184);
}

.resource-pick--selected {
    background-color: rgb(139, 90, 43);
    border-color: rgb(84, 52, 22);
}

.resource-pick-label {
    font-size: 14px;
    color: rgb(58, 42, 24);
    margin: 0 0 0 2px;
    padding: 0;
}

.resource-pick--selected .resource-pick-label {
    color: rgb(250, 238, 212);
}
/* ---------------------------------------------------------------- links, village and player windows */

/* A player's or village's name that opens its window: text that looks like a link. */
.link {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    padding: 0 2px;
    margin: 0 3px;
    min-width: 0;
    height: auto;
    color: rgb(125, 60, 20);
    font-size: 13px;
    -unity-font-style: bold;
}

/* Under the pointer a name or link turns a few shades darker and underlines: no box behind it, and no bold.
   (Specific enough to win over the theme's gray hover and press styles for buttons.) */
.link.unity-button:hover:enabled,
.link.unity-button:active:enabled,
.top-link.unity-button:hover:enabled,
.top-link.unity-button:active:enabled,
.pane-link.unity-button:hover:enabled,
.pane-link.unity-button:active:enabled {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    color: rgb(80, 36, 10);
    border-bottom-color: rgb(80, 36, 10);
}

.link--owner.unity-button:hover:enabled,
.link--owner.unity-button:active:enabled {
    color: rgb(20, 46, 92);
    border-bottom-color: rgb(20, 46, 92);
}

.top-player.unity-button:hover:enabled,
.top-player.unity-button:active:enabled {
    color: rgb(160, 138, 98);
    border-bottom-color: rgb(160, 138, 98);
}

.village-name.unity-button:hover:enabled,
.village-name.unity-button:active:enabled {
    color: rgb(188, 154, 78);
    border-bottom-color: rgb(188, 154, 78);
}

.link.unity-button:focus,
.top-link.unity-button:focus,
.pane-link.unity-button:focus {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.link:disabled {
    color: rgb(110, 84, 54);
}

.link--owner {
    color: rgb(40, 80, 140);
}

.link-line {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 2px;
}

.link-text {
    margin-top: 0;
}

.info-window {
    position: absolute;
    right: 12px;
    top: 94px;
    width: 420px;
    max-height: 82%;
    align-items: stretch;
    padding: 10px 14px;
}

.info-actions {
    justify-content: flex-start;
    margin: 6px 0 2px 0;
}

.info-village-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 0;
    border-bottom-width: 1px;
    border-color: rgba(122, 90, 51, 0.25);
}

.protection-note {
    color: rgb(40, 80, 140);
    -unity-font-style: bold;
}

.report-role {
    margin-right: 2px;
}

.ranking-link {
    font-size: 15px;
}

/* One troop movement in the village view's list or at the rally point. */
.movement-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 4px;
    border-top-width: 1px;
    border-left-width: 4px;
    border-color: rgba(122, 90, 51, 0.25);
    border-left-color: rgb(110, 150, 60);
}

.movement-row--incoming {
    border-left-color: rgb(170, 45, 30);
    background-color: rgba(220, 120, 100, 0.25);
}

.movement-row--return {
    border-left-color: rgb(120, 110, 90);
}

.movement-kind {
    font-size: 12px;
    color: rgb(58, 42, 24);
}

.movement-row--incoming .movement-kind {
    color: rgb(150, 30, 20);
    -unity-font-style: bold;
}

.movement-target {
    margin: 0 4px 0 2px;
}

.movement-countdown {
    font-size: 13px;
    margin-left: 8px;
}

/* An incoming attack's speed, as the icon of its slowest possible unit. */
.attack-speed-icon {
    margin-right: 5px;
}

/* Rams, catapults or noblemen coming: danger (or a fake). */
.movement-row--danger {
    background-color: rgba(200, 60, 40, 0.4);
    border-left-color: rgb(140, 20, 10);
}

/* The Tribe page's list of tribe mates' villages under attack. */
.under-attack {
    margin-bottom: 6px;
}

.under-attack-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 3px 6px;
    border-top-width: 1px;
    border-left-width: 4px;
    border-color: rgba(122, 90, 51, 0.25);
    border-left-color: rgb(170, 45, 30);
}

.under-attack-row > * {
    margin-right: 6px;
}

.under-attack-row--danger {
    background-color: rgba(200, 60, 40, 0.25);
    border-left-color: rgb(140, 20, 10);
}

.under-attack-when {
    white-space: nowrap;
}

.under-attack-reach {
    color: rgb(60, 110, 40);
    -unity-font-style: bold;
    white-space: nowrap;
}

.under-attack-reach--no {
    color: rgb(130, 108, 80);
    -unity-font-style: normal;
}

/* When a movement arrives on the clock (and when an attack's survivors should be back). */
.movement-when {
    margin-left: 12px;
    white-space: nowrap;
}

.movement-row--incoming .movement-countdown {
    color: rgb(150, 30, 20);
}

/* A movement's line and, once clicked, what's in it underneath. */
.movement-item {
    flex-shrink: 0;
}

.movement-caret {
    font-size: 12px;
    width: 12px;
    margin: 0 2px 0 0;
    color: rgb(110, 84, 54);
}

.movement-details {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 2px 6px 4px 20px;
    border-left-width: 4px;
    border-color: rgba(122, 90, 51, 0.25);
    background-color: rgba(255, 255, 255, 0.25);
}

.movement-unit {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
}
.send-icon {
    margin-right: 6px;
}

/* The ranking's page controls, and a row brought into view from a player's profile. */
.ranking-pager {
    justify-content: flex-start;
    align-items: center;
    margin-top: 6px;
}

.ranking-page {
    margin: 0 10px;
}

.ranking-row--focus {
    background-color: rgba(140, 180, 230, 0.45);
    border-radius: 4px;
}

/* A continent's number (K55) written faintly over the middle of its block on the map. */
.continent-label {
    position: absolute;
    translate: -50% -50%;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.35);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.35);
}

/* ---------------------------------------------------------------- villages overview */

.overview {
    justify-content: center;
}

.overview-column {
    flex-grow: 1;
    max-width: 1200px;
}

.overview-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    border-bottom-width: 1px;
    border-color: rgba(122, 90, 51, 0.25);
}

.overview-cell {
    font-size: 13px;
    color: rgb(58, 42, 24);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.overview-name {
    width: 210px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

/* Number columns: centered under their icons, with room between them. */
.overview-number {
    width: 84px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    padding: 0 3px;
}

/* The population column ("used/limit") is the widest. */
.overview-farm {
    width: 116px;
}

.overview-icon-cell {
    align-items: center;
    justify-content: center;
}

/* Construction takes the room left over: the building and level, and under it the time left and queue. */
.overview-building {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 200px;
    padding-left: 12px;
}

.overview-subline {
    font-size: 11px;
    color: rgb(110, 84, 54);
}

/* A village's line in the overview: one height in both modes (room for construction's two lines). */
.overview-line {
    height: 42px;
    flex-shrink: 0;
}

/* A mode's own columns (production or troops), between the points and the incoming attacks. */
.overview-group {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

/* The troops mode: a fixed column for each kind of unit, so the counts line up from village to village. */
.overview-unit-col {
    width: 52px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.overview-unit-col.overview-icon-cell {
    align-items: center;
}

/* No units of that kind at home: a faint 0. */
.overview-zero {
    color: rgba(58, 42, 24, 0.3);
}

/* Headings get the rows' cell style; keep their own weight and color. */
.ranking-header > .overview-cell {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(92, 52, 20);
}

.overview-incoming {
    width: 70px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.overview-full {
    color: rgb(170, 45, 30);
    -unity-font-style: bold;
}

.overview-attacked {
    color: rgb(255, 235, 215);
    background-color: rgb(150, 35, 22);
    border-radius: 4px;
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------- tribes and messages */

.tribe-found {
    margin-top: 6px;
}

.tribe-found-row {
    padding: 6px 8px;
    flex-wrap: wrap;
}

.relation-label {
    margin: 0 8px;
    -unity-font-style: bold;
}

.relation-ally {
    color: rgb(20, 130, 130);
}

.relation-pact {
    color: rgb(120, 60, 160);
}

.relation-enemy {
    color: rgb(170, 30, 20);
}

.relation-none {
    color: rgb(110, 84, 54);
}

.message-body {
    -unity-text-align: upper-left;
    max-width: 700px;
    margin: 10px 0;
}

.map-color-btn {
    margin: 0 0 6px 0;
}

/* ---------------------------------------------------------------- the Account Manager */

.manager-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    border-bottom-width: 1px;
    border-color: rgba(122, 90, 51, 0.25);
}

.manager-name {
    width: 210px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.manager-details {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 0 10px;
}

.manager-dropdown {
    width: 170px;
    flex-shrink: 0;
    margin: 0 6px;
}

.manager-editor {
    padding-bottom: 6px;
}

.manager-troop-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 6px 8px;
}

.manager-troop-cell {
    flex-direction: row;
    align-items: center;
    margin: 3px 10px 3px 0;
}

.manager-actions {
    justify-content: flex-start;
    padding: 4px 8px;
}

.manager-create {
    padding: 6px 8px;
}

.manager-step {
    flex-direction: row;
    align-items: center;
    padding: 2px 8px;
}

.manager-step-number {
    width: 30px;
    flex-shrink: 0;
}

/* ---------------------------------------------------------------- the Loot Assistant */

.loot-template {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 4px 8px;
}

.loot-letter {
    width: 26px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(92, 52, 20);
}

.loot-amount {
    width: 60px;
}

.loot-carry {
    margin: 0 10px 0 4px;
}

.loot-from {
    padding: 2px 8px;
}

.loot-choice {
    width: 36px;
    height: 28px;
    margin: 0 0 0 4px;
    -unity-text-align: middle-center;
}

.loot-dot-cell {
    width: 22px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

/* How the last raid went: green won cleanly, yellow won with losses, red beaten; hollow if never raided. */
.loot-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(84, 52, 22);
    background-color: rgba(0, 0, 0, 0);
}

.loot-dot--clean {
    background-color: rgb(70, 160, 60);
}

.loot-dot--losses {
    background-color: rgb(230, 180, 40);
}

.loot-dot--defeat {
    background-color: rgb(190, 40, 30);
}

.loot-full {
    color: rgb(70, 140, 50);
    font-size: 12px;
    margin-left: 4px;
}

.loot-col {
    width: 80px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.loot-col-wide {
    width: 170px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.loot-col-narrow {
    width: 50px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.loot-send {
    width: 34px;
    height: 26px;
    margin: 0 3px 0 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* A raid is on its way to (or back from) this village: its buttons go gray. */
.loot-send--sent,
.loot-send--sent:hover {
    background-color: rgb(178, 174, 166);
    border-color: rgb(128, 124, 118);
    color: rgb(92, 90, 86);
}

/* Can't send this one now: faded, but still hoverable for the reason why. */
.loot-send--unable {
    opacity: 0.45;
}

/* A cycle that stopped by itself: its button stands out until the player looks. */
.loot-stopped {
    border-color: rgb(190, 40, 30);
    color: rgb(150, 30, 20);
}

/* The troop targets window: over the village list, beside the button that opened it. */
.manager-popup {
    position: absolute;
    width: 470px;
    background-color: rgb(250, 240, 214);
    border-width: 2px;
    border-color: rgb(122, 90, 51);
    border-radius: 6px;
    padding-bottom: 4px;
}

.manager-popup-header {
    flex-direction: row;
    align-items: center;
    background-color: rgb(196, 163, 108);
    padding: 3px 4px 3px 8px;
}

.manager-popup-title {
    flex-grow: 1;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(60, 36, 14);
}

.manager-popup-close {
    width: 26px;
    height: 24px;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
}

.manager-popup-hint {
    white-space: normal;
    padding: 4px 8px 0 8px;
}

/* The Loot Assistant's pinned bar (troops at home, raids left) above its scrolling list. */
.loot-layout {
    flex-direction: column;
}

.loot-scroll {
    flex-grow: 1;
}

.loot-home-bar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    background-color: rgb(250, 240, 214);
    border-width: 1px;
    border-color: rgb(160, 126, 82);
    padding: 5px 10px;
    margin-bottom: 4px;
}

.loot-home-title {
    margin-right: 8px;
}

.loot-home-units {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-grow: 1;
}

.loot-home-cell {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.loot-home-count {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(58, 42, 24);
    margin-left: 3px;
}

.loot-raids-left {
    margin-left: 12px;
}

/* Hover tooltips (drawn by the game: UI Toolkit shows none at runtime). */
.ui-tooltip {
    position: absolute;
    max-width: 340px;
    background-color: rgb(58, 42, 24);
    border-width: 1px;
    border-color: rgb(196, 163, 108);
    border-radius: 4px;
    padding: 4px 8px;
}

.ui-tooltip-text {
    color: rgb(250, 238, 212);
    font-size: 12px;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.ui-tooltip-note {
    margin-top: 3px;
    color: rgb(230, 205, 160);
}

/* A troop tip's units: icon and count, side by side, wrapping. */
.ui-tooltip-troops {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
}

.ui-tooltip-unit {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
}

.ui-tooltip-count {
    color: rgb(250, 238, 212);
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 3px;
}

/* ---------------------------------------------------------------- send dialog: a layout that never moves */

/* Nothing in the dialog gives way (or overlaps) when space runs short. */
.send-panel > * {
    flex-shrink: 0;
}

/* The units in two columns: foot and siege on the left, horse and noblemen on the right. */
.send-grid {
    flex-direction: row;
    justify-content: space-between;
}

.send-column {
    width: 49%;
}

.send-column .send-name {
    width: 118px;
}

.send-column .send-amount {
    width: 72px;
}

/* A unit with none at home, or an option that doesn't apply to the troops chosen: grayed out. */
.send-row:disabled {
    opacity: 0.45;
}

/* Room for the longest summary (a noble train's, with support timing) and two lines of warnings, always. */
.send-summary {
    min-height: 110px;
    -unity-text-align: upper-center;
}

.send-reason {
    min-height: 32px;
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------- reports: the list or the archive, with boxes to tick */

.reports-tabs {
    justify-content: flex-start;
}

.reports-tabs > .option {
    margin: 0 6px 6px 0;
    padding: 4px 14px;
    font-size: 15px;
}

.report-row {
    flex-direction: row;
    align-items: center;
}

.report-row > .report-item {
    flex-grow: 1;
    flex-shrink: 1;
}

/* The checkboxes: small parchment squares like the report cards, gold like a chosen card when ticked. */
.check-box {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 2px;
    border-color: rgba(122, 90, 51, 0.45);
    border-radius: 4px;
}

.check-box:hover {
    background-color: rgba(255, 255, 255, 0.55);
}

.check-box--checked,
.check-box--checked:hover {
    border-color: rgb(192, 140, 40);
    background-color: rgba(255, 225, 140, 0.75);
}

.check-box:disabled {
    opacity: 0.4;
}

.report-check {
    margin: 0 8px 5px 2px;
}

.reports-select-all {
    margin-bottom: 2px;
}

.reports-select-all > .report-check {
    margin-bottom: 0;
}

/* A report in a village's window: on one line, its start always showing, cut off at the end if it's too long. */
.report-link-line {
    flex-wrap: nowrap;
}

.report-link-time {
    flex-shrink: 0;
}

.report-link {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

/* ---------------------------------------------------------------- the Account Manager: renaming a village */

.manager-village-link {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.manager-coords {
    flex-shrink: 0;
}

/* The pencil: just the icon, a faint box under the pointer. */
.pencil-btn.unity-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 4px;
    padding: 0;
    margin: 0 4px 0 0;
    min-width: 0;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    opacity: 0.8;
}

.pencil-btn.unity-button:hover:enabled,
.pencil-btn.unity-button:active:enabled {
    background-color: rgba(122, 90, 51, 0.18);
    opacity: 1;
}

.pencil-btn.unity-button:focus {
    background-color: rgba(0, 0, 0, 0);
}

.rename-field.manager-rename-field {
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 28px;
    margin: 0 4px 0 0;
}

.manager-rename-btn {
    min-width: 0;
    width: 32px;
    height: 26px;
    padding: 0;
    margin: 0 2px 0 0;
    font-size: 12px;
}

/* ---------------------------------------------------------------- the Loot Assistant: each village's latest raid */

.loot-report-cell {
    width: 100px;
    flex-shrink: 0;
    margin-left: 6px;
    align-items: flex-start;
}

/* The Account Manager's troop share: how much of a village's spending goes on troops. */
/* The label, then the five choices sharing what's left of the row equally (so they always fit the popup). */
.manager-share-row {
    justify-content: flex-start;
    align-items: center;
    flex-wrap: nowrap;
    margin-top: 8px;
    padding: 0 8px;
}

.manager-share-label {
    margin-right: 6px;
    flex-shrink: 0;
}

.manager-share-row > .manager-share {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin: 2px 3px 2px 0;
    padding: 3px 0;
    font-size: 14px;
    -unity-text-align: middle-center;
}

/* The troop targets' population against the farm's room: red when even a full farm couldn't hold them. */
.manager-troop-population {
    margin-top: 6px;
    white-space: normal;
}

.manager-troop-population--over {
    color: rgb(150, 40, 25);
}

/* ---------------------------------------------------------------- gold coins at the academy */

.coin-stats {
    flex-direction: row;
    align-items: center;
    margin: 2px 0 6px 0;
}

.coin-stat {
    flex-direction: row;
    align-items: center;
    margin-right: 22px;
}

.coin-stat-icon {
    margin-right: 6px;
}

.coin-stat-value {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(92, 52, 20);
    margin-right: 5px;
}

.coin-stat-value--none {
    color: rgb(150, 40, 25);
}

.coin-stat-label {
    font-size: 14px;
    color: rgb(110, 84, 54);
}

.coin-next {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.coin-next-bar {
    width: 180px;
    height: 10px;
    margin: 0 10px 0 0;
}

.coin-next-fill {
    background-color: rgb(214, 164, 40);
}

.coin-next-text {
    margin-top: 0;
}

.coin-inline-icon {
    margin: 0 4px;
}

.coin-hint {
    margin-bottom: 6px;
    white-space: normal;
}

.coin-mint-title {
    flex-direction: row;
    align-items: center;
}

/* Support stationed in the village, under its own units in the village pane: set apart, a quieter color. */
.pane-subtitle {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(110, 84, 54);
    padding: 4px 8px 1px 8px;
}

.pane-line--support .pane-count,
.pane-line--support .pane-name {
    color: rgb(40, 80, 140);
}

/* A building's name in the headquarters' list: a link to its own screen, as big as the row titles. */
.row-title-link {
    font-size: 15px;
    margin-left: 0;
    padding-left: 0;
}

/* A village's troop targets in the Account Manager: icons and counts on a line (wrapping if need be). */
.manager-troops {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 2px;
}

.manager-troops-share {
    margin-right: 8px;
    -unity-font-style: bold;
}

.manager-troop-target {
    flex-direction: row;
    align-items: center;
    margin-right: 9px;
}

.manager-troop-icon {
    margin-right: 3px;
}

.manager-troop-count {
    margin: 0;
}

/* A village's stores in its window: as on the top bar (icons, numbers whose digits stay put), in the window's ink. */
.stores-line {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 2px;
}

.stores-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.stores-value {
    flex-direction: row;
    justify-content: flex-end;
    min-width: 66px;
    margin-left: 3px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(58, 42, 24);
}

.stores-value--full {
    color: rgb(170, 45, 30);
}

/* The villages overview's totals: a line of icons with counts. */
.overview-summary {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 4px;
}

.overview-summary-group {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.overview-summary-text {
    margin: 0 8px 0 0;
}

.overview-summary-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
}

.overview-summary-count {
    margin: 0 0 0 3px;
    -unity-font-style: bold;
}

/* The rally point's list of the player's villages, to pick a target from. */
.village-picker {
    position: absolute;
    width: 300px;
    max-height: 260px;
    background-color: rgb(250, 240, 214);
    border-width: 2px;
    border-color: rgb(122, 90, 51);
    border-radius: 6px;
    padding-bottom: 4px;
}

.village-picker-scroll {
    max-height: 220px;
}

.village-picker-item {
    -unity-text-align: middle-left;
    align-self: flex-start;
    margin: 3px 8px;
}

.rally-choose-village {
    margin-left: 6px;
}

/* The villages overview's Recruiting column: the units in training as icons with counts, on one line
   (wrapping within the column rather than running into the next). */
.overview-recruiting {
    width: 190px;
    flex-shrink: 0;
    padding-left: 8px;
}

.overview-recruiting-units {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.overview-recruit-unit {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
}

.overview-recruit-count {
    margin-left: 2px;
}
